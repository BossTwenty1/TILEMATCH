# Server Configuration
PORT=5000
NODE_ENV=production

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tilematch_db

# Security
# Required: generate a unique secret with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Store it only in the deployment's secret settings or your untracked .env file.
JWT_SECRET=

# CORS
# FRONTEND_URL=https://your-tilematch-frontend.vercel.app

# Email SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
